{
  "expo": {
    "name": "Advent Bible Journey",
    "slug": "advent-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "advent-calendar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.transfigurationchurch.adventbiblejourney",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] }
        ]
      },
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.transfigurationchurch.adventbiblejourney",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.RECORD_AUDIO", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "com.google.android.gms.permission.AD_ID"],
      "adaptiveIcon": {
        "backgroundColor": "#101A3A",
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#101A3A",
          "android": {
            "image": "./assets/branding/splash-transparent.png",
            "imageWidth": 1
          },
          "dark": {
            "backgroundColor": "#101A3A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withLocalOnlyNotifications.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
